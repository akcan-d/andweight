<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.WRITE_WEIGHT" />

    <!-- Required for Health Connect integration to work at all - without this, package-visibility
         restrictions (Android 11+) keep this app from resolving or being resolved by the Health
         Connect provider: getSdkStatus() can misreport availability, and the permission-request
         intent can silently fail to launch anything. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".AndWeightApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.AndWeight">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.AndWeight">
            <!-- Required by Health Connect for every client app, regardless of which record
                 types it uses - lets a user reach this app's data-use explanation from Health
                 Connect's own "App permissions" screen, not just from inside Measured itself.
                 This is the pre-Android 14 action string (Health Connect as a separate app);
                 Android 14+ uses the differently-named activity-alias below instead, since that
                 path requires a signature permission this shared activity can't carry directly.
                 Handled in MainActivity.onCreate by jumping straight to the privacy policy. Left
                 unrestricted (no android:permission) since this can be reached from an ordinary
                 link tap, not just from Health Connect itself. -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Android 14+ equivalent of the rationale intent-filter above - same handling in
             MainActivity.onCreate, reached through a separate alias (rather than another
             intent-filter directly on MainActivity) because this path is gated by a signature
             permission that only Health Connect itself holds, and that restriction must not leak
             onto MainActivity's normal, unrestricted launcher-alias entry points. -->
        <activity-alias
            android:name=".HealthConnectRationaleAlias"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Lets Health Connect launch straight into this app when the user starts the connection
             from Health Connect's own "compatible apps" list rather than from inside Measured -
             without this, Health Connect has no registered entry point into the app and may not
             list it as integrated at all. There's no separate onboarding flow to show; this just
             opens the app normally; MainActivity.onCreate needs no special handling for either
             action. Pre-Android 14 (Health Connect as a separate app) and Android 14+ (built into
             the platform) each require their own alias with their own signature permission, same
             reasoning as the rationale alias above. -->
        <activity-alias
            android:name=".HealthConnectOnboardingAlias"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:permission="com.google.android.apps.healthdata.permission.START_ONBOARDING">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_ONBOARDING" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".HealthConnectOnboardingAliasV14"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:permission="android.permission.health.START_ONBOARDING">
            <intent-filter>
                <action android:name="android.health.connect.action.SHOW_ONBOARDING" />
            </intent-filter>
        </activity-alias>

        <!-- Three aliases for the same activity, each with its own launcher icon - exactly one
             enabled at a time (see AppIconSwitcher). The launcher intent-filter lives on these,
             not on MainActivity itself, since Android only lets one component own it per icon. -->
        <activity-alias
            android:name=".MainActivitySage"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".MainActivityBerry"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_berry"
            android:roundIcon="@mipmap/ic_launcher_berry_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".MainActivityOcean"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_ocean"
            android:roundIcon="@mipmap/ic_launcher_ocean_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <receiver
            android:name=".notifications.ReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".notifications.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.WeightLostWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_weight_lost_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weight_lost_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.PercentProgressWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_percent_progress_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/percent_progress_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.TimeRemainingWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_time_remaining_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/time_remaining_widget_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
