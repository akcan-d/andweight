<?xml version="1.0" encoding="utf-8"?>
<!-- Everything this app stores is the person's own weight/meal history and settings - nothing
     sensitive enough to exclude from either cloud backup or device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
